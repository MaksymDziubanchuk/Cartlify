{
  "name": "cartlify",
  "type": "module",
  "version": "1.0.0",
  "description": "Cartlify - E-commerce pet-project with Fastify, Prisma, PostgreSQL and Cloudinary.",
  "main": "src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx dist/index.js",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:test:up": "node db/tools/test_db_build.mjs up",
    "db:test:down": "node db/tools/test_db_build.mjs down",
    "db:snapshot:save": "node db/tools/structure_snapshot.mjs save",
    "db:snapshot:check": "node db/tools/structure_snapshot.mjs check",
    "db:snapshot:check:db": "node db/tools/structure_snapshot.mjs check db",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs unit",
    "test:integration": "node tests/run.mjs integration",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "ecommerce",
    "cartlify"
  ],
  "author": "Maksym Dziubanchuk",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "redis": "5.11.0",
    "stripe": "^20.4.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@inquirer/prompts": "^8.7.3",
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "@prisma/client@6.15.0": true,
    "@prisma/engines@6.19.1": true,
    "prisma@6.19.1": true,
    "esbuild@0.25.9": true
  }
}
