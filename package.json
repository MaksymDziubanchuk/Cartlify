{
  "name": "cartlify",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Cartlify - e-commerce backend on Fastify, Prisma and PostgreSQL with row-level security, Redis, Stripe and Cloudinary.",
  "main": "src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:test:up": "node db/tools/test_db_build.mjs up",
    "db:test:down": "node db/tools/test_db_build.mjs down",
    "db:snapshot:save": "node db/tools/structure_snapshot.mjs save",
    "db:snapshot:check": "node db/tools/structure_snapshot.mjs check",
    "db:snapshot:check:db": "node db/tools/structure_snapshot.mjs check db",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs unit",
    "test:integration": "node tests/run.mjs integration",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "ecommerce",
    "cartlify"
  ],
  "author": "Maksym Dziubanchuk",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0",
    "stripe": "^23.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/fast-json-stringify-compiler": "^5.1.1",
    "@inquirer/prompts": "^8.7.3",
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
