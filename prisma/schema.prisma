// connection urls live in prisma.config.ts (prisma 7)
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  ADMIN
  ROOT
}

enum UserTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  REFRESH_TOKEN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  LINKEDIN
}

enum ReviewVoteAction {
  UP
  DOWN
}

enum OrderStatus {
  pending
  unconfirmed
  waiting
  paid
  shipped
  delivered
  cancelled
}

enum PaymentProvider {
  stripe
  liqpay
}

// how a change of a price is given: a percent of the price or an amount of money; a line of the
// log with endsAt is the start of a sale
enum PriceChangeMode {
  percent
  fixed
}

// where a batch of a product came from: a delivery of a supplier, a surplus an inventory found,
// the goods a buyer brought back
enum StockSource {
  supplier
  surplus
  customer_return
}

enum AdminAuditEntityType {
  user
  product
  category
  order
  review
  other
}

enum AdminAuditAction {
  USER_ROLE_CHANGE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  PRODUCT_PRICE_BULK_UPDATE
  // a sale set, changed or taken off by an admin, or ended by a price down to it (db/05)
  PRODUCT_SALE
  // a batch taken in and the units written off, a line for each product (db/05)
  STOCK_DELIVERY
  STOCK_WRITE_OFF
  ORDER_STATUS_CHANGE
  CATEGORY_UPDATE
  REVIEW_DELETE
  OTHER
}

enum ChatStatus {
  open
  closed
}

enum ChatType {
  bot
  admin
}

enum ChatMessageSenderType {
  user
  admin
  bot
  guest
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String?
  role         Role    @default(USER)

  authProvider AuthProvider @default(LOCAL)
  providerSub  String?

  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?

  name      String?
  avatarUrl String?
  publicId  String?
  locale    String?
  phone     String?

  userTokens              UserToken[]
  loginLogs               LoginLog[]
  reviews                 Review[]
  votes                   ReviewVote[]
  favorites               Favorite[]
  orders                  Order[]
  productPriceChangeLogs  ProductPriceChangeLog[]
  adminAuditLogs          AdminAuditLog[]
  alertSettings           AdminAlertSetting[]
  // root: the versions of the terms and of the contract they published
  legalDocumentsPublished LegalDocument[]         @relation("LegalDocumentPublisher")
  legalAcceptances        LegalAcceptance[]
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]

  @@unique([authProvider, providerSub])
  @@index([authProvider])
  @@index([createdAt])
  @@index([isVerified, createdAt])
  @@map("users")
}

model UserToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      UserTokenType
  token     String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  // a session token: the session it belongs to, kept across its renewals, and the browser that
  // opened it (db/06: a session token has a session, no other link has one)
  sessionId String?   @db.Uuid
  userAgent String?
  // a session closed on purpose (a logout, a reset of the password, a role change), at the moment
  // it was closed; a token closed by its renewal has none, and that one coming back is theft
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt])
  @@index([sessionId])
  @@map("user_tokens")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  role      Role
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_logs")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  parentId Int?
  parent   Category?  @relation("CategoryToSubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  // the article number: optional, one product of the catalog has it at a time, whatever the case
  // of its letters (db/06)
  sku         String? @db.VarChar(64)

  price         Decimal @db.Decimal(10, 2)
  stock         Int     @default(0)
  reservedStock Int     @default(0)

  // the sale: its price is the price of the product while saleEndsAt is ahead; both empty or both
  // set (db/06), a price down to the sale price or below empties them (db/05)
  salePrice      Decimal?  @db.Decimal(10, 2)
  saleEndsAt     DateTime?
  // the lowest price of the 30 days before the sale, written with it and gone with it (db/06)
  salePriorPrice Decimal?  @db.Decimal(10, 2)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  views Int @default(0)

  popularity              Int       @default(0)
  popularityOverride      Int?
  popularityOverrideUntil DateTime?

  avgRating    Decimal @default(0) @db.Decimal(3, 2)
  reviewsCount Int     @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reviews         Review[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  priceChangeLogs ProductPriceChangeLog[]
  images          ProductImage[]
  batches         ProductBatch[]
  allocations     OrderBatchAllocation[]

  @@index([categoryId])
  @@index([price, id])
  @@index([createdAt, id])
  @@index([name, id])
  @@index([popularity, id])
  @@index([views, id])
  @@index([stock, id])
  @@index([updatedAt, id])
  @@index([avgRating, id])
  @@index([reviewsCount, id])
  @@map("products")
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String?
  alt      String?

  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId, position])
  @@map("product_images")
}

model Review {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int?

  upVotes   Int @default(0)
  downVotes Int @default(0)

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  votes ReviewVote[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewVote {
  id Int @id @default(autoincrement())

  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action ReviewVoteAction

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model Favorite {
  id Int @id @default(autoincrement())

  userId  Int?
  guestId String? @db.Uuid
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([guestId, productId])
  @@index([productId])
  @@map("favorites")
}

model Order {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  status               OrderStatus @default(pending)
  reservationExpiresAt DateTime?
  confirmed            Boolean     @default(false)

  total Decimal @db.Decimal(10, 2)

  // who took the money and the id of the payment there (a Stripe PaymentIntent, a LiqPay order
  // id); pay_order sets both together
  paymentProvider PaymentProvider?
  paymentId       String?          @unique

  // when the payment was recorded (pay_order, with the payment) and when an admin cancelled the
  // paid order (cancel_paid_order); utc, only those functions set them (db/03, db/06)
  paidAt      DateTime?
  cancelledAt DateTime?

  shippingAddress    String?
  recipientFirstName String?
  recipientLastName  String?
  recipientPhone     String?
  note               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items            OrderItem[]
  allocations      OrderBatchAllocation[]
  // the versions of the terms and of the contract the order was confirmed with
  legalAcceptances LegalAcceptance[]

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, confirmed, status, updatedAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([confirmed, reservationExpiresAt])
  @@index([paidAt, id])
  @@index([cancelledAt])
  @@map("orders")
}

// a batch of a product: what came in at once at one cost of a unit, in the currency of the shop.
// The stock of the product is what its batches have left (db/05); only the functions of the
// database take a batch in and take units out of it. Who took it in, the supplier, the invoice
// and the note are in the admin log (STOCK_DELIVERY)
model ProductBatch {
  id Int @id @default(autoincrement())

  // a product removed for good takes its batches with it; a batch a paid order took units from
  // stays, so does its product
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // the delivery it came with: one delivery takes in batches of several products
  deliveryId String @db.Uuid

  source              StockSource
  // the number the supplier gave the batch, when there is one
  supplierBatchNumber String?

  unitCost  Decimal   @db.Decimal(10, 2)
  quantity  Int
  remaining Int
  // the last day the goods are good for; a sale takes the batch that ends first, a batch without
  // an end after them, the oldest first
  expiresAt DateTime? @db.Date

  createdAt DateTime @default(now())

  allocations OrderBatchAllocation[]

  @@index([productId, expiresAt, createdAt, id])
  @@index([createdAt, id])
  @@index([deliveryId])
  @@map("product_batches")
}

// the units a paid order took from each batch: the cost of the goods it sold. A cancel of the
// order puts them back into the same batches and keeps the line for the reports
model OrderBatchAllocation {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  batchId Int
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())

  @@unique([orderId, batchId])
  @@index([batchId])
  @@index([productId])
  @@map("order_batch_allocations")
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  // the name of the product: it follows the product while the order is a cart, the confirm keeps
  // the name of that moment (db/05); empty for an item from before it was kept
  productName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ChatThread {
  id String @id @db.Uuid

  userId  Int?
  guestId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   ChatType
  status ChatStatus @default(open)

  lastMessageAt      DateTime  @default(now())
  unreadCount        Int       @default(0)
  adminUnreadSince   DateTime?
  adminRequestedAt   DateTime?
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([userId, status, type, lastMessageAt])
  @@index([guestId, status, type, lastMessageAt])
  @@index([status, adminUnreadSince])
  @@map("chat_threads")
}

model ChatMessage {
  id Int @id @default(autoincrement())

  threadId String     @db.Uuid
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId Int?
  sender   User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  senderType ChatMessageSenderType

  content String

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model ProductPriceChangeLog {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  actorId Int
  actor   User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  oldPrice Decimal @db.Decimal(10, 2)
  newPrice Decimal @db.Decimal(10, 2)

  mode  PriceChangeMode
  value Decimal         @db.Decimal(10, 2)

  // the end of the sale a line starts: a line with an end is the start of a sale, from the price
  // down to the sale price (db/06); empty for any other line
  endsAt DateTime?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([actorId, createdAt])
  @@map("product_price_change_logs")
}

// the settings of a kind of alerts of an admin or root, each of their own: whether it is on and
// its threshold; a kind without a row is on with the threshold the server gives, and a threshold
// left empty is that one too
model AdminAlertSetting {
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String  @db.VarChar(64)
  subscribed Boolean @default(true)
  threshold  Int?

  createdAt DateTime @default(now())

  @@id([userId, kind])
  @@map("admin_alert_settings")
}

model AdminAuditLog {
  id Int @id @default(autoincrement())

  actorId Int
  actor   User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  actorRole Role

  entityType AdminAuditEntityType
  entityId   Int?

  action AdminAuditAction
  meta   Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  // the reports read the lines of an action in a period: the write-offs of a month
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

// a kind of the legal texts of the shop the customers accept
enum LegalDocumentKind {
  terms
  contract
}

// a version of the terms or of the contract of the shop. Root publishes it, nobody changes or takes
// it away; the database numbers the versions of each kind and keeps the sha256 of the text (db/05)
model LegalDocument {
  id            Int               @id @default(autoincrement())
  kind          LegalDocumentKind
  version       Int
  title         String            @db.VarChar(200)
  content       String
  sha256        String            @db.VarChar(64)
  publishedById Int
  publishedBy   User              @relation("LegalDocumentPublisher", fields: [publishedById], references: [id])

  createdAt DateTime @default(now())

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@map("legal_documents")
}

// a consent of a customer to a version in force: at the registration or later (orderId empty),
// and the versions an order was confirmed with (orderId). Only added; the address and the browser
// are the ones of the request (db/05)
model LegalAcceptance {
  id         Int           @id @default(autoincrement())
  userId     Int
  user       User          @relation(fields: [userId], references: [id])
  documentId Int
  document   LegalDocument @relation(fields: [documentId], references: [id])
  orderId    Int?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("legal_acceptances")
}
