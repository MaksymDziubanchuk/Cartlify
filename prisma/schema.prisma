// The models of the shop. This file holds only the tables. The rules of the database (row level
// security, functions, triggers, checks, unique indexes) are in db/schema/*.sql and are named
// below as db/03 (policies), db/05 (functions and triggers) and db/06 (checks and indexes).
// The url of the database is not here: prisma 7 reads it from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Users and sessions
// -----------------------------------------------------------------------------

// GUEST is a visitor without an account (a guest id in a cookie). USER is a buyer, ADMIN works in
// the shop, ROOT is the owner and the only one who makes or removes admins.
enum Role {
  GUEST
  USER
  ADMIN
  ROOT
}

// What a user_tokens row is: the link of the mail that confirms an email, the link that resets a
// password, or a session (the refresh token).
enum UserTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  REFRESH_TOKEN
}

// How an account signs in: LOCAL is email and password, the others are OAuth providers.
enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  LINKEDIN
}

// An account of a buyer, an admin or the owner. The row is never removed: a deleted account keeps
// it with deletedAt set, a placeholder email and the name Guest, because orders and journals refer
// to it. The email is stored in lower case with no spaces around it (db/05).
model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  // empty for an account that signs in through a provider
  passwordHash String?
  role         Role    @default(USER)

  authProvider AuthProvider @default(LOCAL)
  // the id of the account at the provider; empty for LOCAL
  providerSub  String?

  // the email is confirmed (a password login needs it) or the provider confirmed it
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  // when the account was deleted
  deletedAt  DateTime?

  name      String?
  // the avatar in Cloudinary, its url and its public id; without them the app shows a picture
  // with the initials
  avatarUrl String?
  publicId  String?
  locale    String?
  // in the international form, +380501234567
  phone     String?

  userTokens              UserToken[]
  loginLogs               LoginLog[]
  reviews                 Review[]
  votes                   ReviewVote[]
  favorites               Favorite[]
  orders                  Order[]
  productPriceChangeLogs  ProductPriceChangeLog[]
  adminAuditLogs          AdminAuditLog[]
  stockLogs               StockLog[]
  alertSettings           AdminAlertSetting[]
  // the versions of the terms and of the contract this account published (only root does)
  legalDocumentsPublished LegalDocument[]         @relation("LegalDocumentPublisher")
  legalAcceptances        LegalAcceptance[]
  // the versions of the data of the shop this account wrote (only root does; a row the server
  // wrote for an empty field has no one here)
  shopSettingsSet         ShopSetting[]
  // the statements of withdrawal this account made or confirmed the proof of
  returnsCreated          OrderReturn[]           @relation("ReturnCreator")
  returnsProofConfirmed   OrderReturn[]           @relation("ReturnProofConfirmer")
  returnsAccepted         OrderReturn[]           @relation("ReturnAcceptor")
  returnsClosed           OrderReturn[]           @relation("ReturnCloser")
  returnsReimbursed       OrderReturn[]           @relation("ReturnShippingReimburser")
  returnItemsSet          OrderReturnItem[]       @relation("ReturnItemGoodsSetter")
  returnItemsOutside      OrderReturnItem[]       @relation("ReturnItemOutsideSetter")
  returnShipmentsRecorded ReturnShipment[]        @relation("ReturnShipmentRecorder")
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]

  // the unique index also serves a search by authProvider alone
  @@unique([authProvider, providerSub])
  @@index([createdAt])
  @@index([isVerified, createdAt])
  @@map("users")
}

// A link of the mail or a session of an account. A session is a chain of rows: each renewal closes
// the row and adds a new one.
model UserToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      UserTokenType
  // the sha256 of the secret, never the secret itself
  token     String        @unique
  expiresAt DateTime
  // when a link was used, or when a session token was renewed or closed
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  // the session of a REFRESH_TOKEN row, the same through all its renewals; a link has none (db/06)
  sessionId String?   @db.Uuid
  // the browser that opened the session
  userAgent String?
  // when the session was closed on purpose (logout, password reset or change, role change,
  // expiry); it equals usedAt then (db/06). A token closed only by its renewal has none: if that
  // one comes back it was copied, and every session of the account is closed
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt])
  @@index([sessionId])
  @@map("user_tokens")
}

// One successful login, written by the server. Only added: nobody edits or deletes a line. The
// exceptions are the placeholder email that a deleted account gives its lines
// (anonymize_login_logs) and the address and browser, which are emptied after the keeping time
// (cleanup_login_log_addresses).
model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  // the email and the role of the account at the time of the login
  email     String
  role      Role
  // the address and the browser of the request
  ipAddress String?
  userAgent String?
  // how the person came in: login.password, login.google, login.github, login.linkedin (the list is
  // src/config/journalEvents.ts)
  event     String   @db.VarChar(60)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([event, createdAt])
  @@map("login_logs")
}

// -----------------------------------------------------------------------------
// Catalog: categories, products, variants, characteristics
// -----------------------------------------------------------------------------

// what a characteristic holds: a text, a number, yes or no, one of a list of values, or several
// of them
enum AttributeType {
  text
  number
  boolean
  option
  options
}

// what a document of a product is
enum DocumentKind {
  instruction
  certificate
  declaration
  other
}

// What the law lets a buyer do when they withdraw from a purchase of the goods (Directive
// 2011/83, art. 16): allowed takes them back freely; sealed_hygiene, sealed_media and mixed only
// while the seal is unbroken (16 e, 16 i, 16 f); perishable, personalised and periodical not at
// all (16 d, 16 c, 16 j). The database derives the three kinds from the value, nothing stores them.
enum WithdrawalRule {
  allowed
  sealed_hygiene
  sealed_media
  mixed
  perishable
  personalised
  periodical
}

// A category of products. The tree goes only top down: a category never goes inside its own branch
// (CATEGORY_PARENT_CYCLE, db/05). A category with products cannot be deleted; the server moves the
// children of a deleted category to its parent.
model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  // the picture of the category, optional: where it lies on Cloudinary and its id there (both or
  // none, db/06)
  imageUrl      String?
  imagePublicId String?

  // the rule of withdrawal its products follow while they have none of their own; empty follows
  // the category above it (product_withdrawals, db/05)
  withdrawal WithdrawalRule?

  // the parent category; empty for a top category
  parentId Int?
  parent   Category?  @relation("CategoryToSubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products   Product[]
  attributes CategoryAttribute[]

  @@index([parentId])
  @@map("categories")
}

// The directory of the parties a product names: the manufacturer and the person responsible in the
// EU (GPSR). One row serves every product of the party, so an address changed here changes in all of
// them. The values are held by db/06: lengths, the email, the country as two capitals, and one row
// for one name, address and country.
model Party {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  email     String
  // the country, ISO 3166 alpha-2 in capitals
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  manufactured Product[] @relation("ProductManufacturer")
  represented  Product[] @relation("ProductEuResponsible")

  @@map("parties")
}

// The directory of the characteristics a variant of a product has: a group is a section of the
// tab of the characteristics of a card ("Screen", "Memory"), a characteristic is "Diagonal" or
// "Colour", its values come from a list when it is a choice. The positions are the order of the
// card: one place for one row in its scope (db/06 keeps them unique, checked at the end of a
// transaction so that a new order is written row by row).
model AttributeGroup {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  attributes Attribute[]

  @@map("attribute_groups")
}

model Attribute {
  id        Int            @id @default(autoincrement())
  name      String
  type      AttributeType
  // a label only ("GB", "mm"): nothing is converted
  unit      String?
  groupId   Int
  group     AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  position  Int
  // a main characteristic splits the products of a list into rows by its value (a colour); only a
  // choice, a number or yes/no can be one (db/06)
  isMain    Boolean        @default(false)
  // a buyer may filter the catalog by it (a text never is)
  inFilters Boolean        @default(true)
  // a number: the digits after the point (0 to 3) and the bounds; empty for the other types (db/06)
  decimals  Int?
  minValue  Decimal?       @db.Decimal(18, 3)
  maxValue  Decimal?       @db.Decimal(18, 3)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  options    AttributeOption[]
  categories CategoryAttribute[]
  values     VariantAttributeValue[]

  @@map("attributes")
}

// a value of a characteristic that is a choice: "black", "XL", "iOS"; found by its id, so a rename
// breaks no filter
model AttributeOption {
  id          Int       @id @default(autoincrement())
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  // for a swatch of a colour on the storefront: #RRGGBB
  colorCode   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  values VariantAttributeValue[]

  @@map("attribute_options")
}

// the characteristics a category asks of its products, and which of them are required; a child
// category has the ones of its parents too (read, not stored)
model CategoryAttribute {
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  required    Boolean   @default(false)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

// The directory of the documents products show to a buyer: an instruction, a certificate, a
// declaration of conformity, as PDF files kept on Cloudinary as raw files (the public id keeps
// the .pdf). One row serves every product that names it. db/06 holds the values.
model Document {
  id        Int          @id @default(autoincrement())
  title     String
  kind      DocumentKind
  // where the file lies on Cloudinary, and its public id there
  url       String
  publicId  String       @unique
  sizeBytes Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  products ProductDocument[]

  @@index([kind])
  @@map("documents")
}

// the documents a product names, in the order an admin gave them (position from 1, one place for
// one document); a document in use cannot be deleted
model ProductDocument {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  position   Int

  @@id([productId, documentId])
  @@unique([productId, position])
  @@index([documentId])
  @@map("product_documents")
}

// A product of the catalog. Taking it out of the catalog sets deletedAt and the row stays, because
// batches, orders and journals refer to it. The stock, the reserved stock, the rating and the
// popularity are kept by database functions and triggers (db/05); the app does not write them
// directly.
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  // plain text; the safety and origin data of the product are the manufacturer and the person
  // responsible in the EU below, and the warnings
  description String?

  // what a buyer chooses and buys: the price, the sale, the stock, the article number, the weight
  // and the size are not here, every variant has its own. A product has at least one variant

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // who made the product (EU GPSR), and the person who answers for it in the EU, which a
  // manufacturer outside the EU needs; a party in use cannot be deleted
  manufacturerId  Int
  manufacturer    Party   @relation("ProductManufacturer", fields: [manufacturerId], references: [id], onDelete: Restrict)
  euResponsibleId Int?
  euResponsible   Party?  @relation("ProductEuResponsible", fields: [euResponsibleId], references: [id], onDelete: Restrict)
  // the warnings of the product, plain text, optional (db/06 holds the length)
  warnings        String?

  // the rule of withdrawal of its own; empty follows its category, and the nearest category above
  // it that has one, and by default allowed (product_withdrawals, db/05)
  withdrawal WithdrawalRule?

  // how many times buyers opened the card (an admin's opens are not counted)
  views Int @default(0)

  // the score the catalog sorts by, counted by the database from the views and from the
  // favorites, carts, purchases and reviews of the last 30 days (recalc_product_popularity, db/05)
  popularity              Int       @default(0)
  // a score an admin sets instead; it counts only while popularityOverrideUntil is ahead
  popularityOverride      Int?
  popularityOverrideUntil DateTime?

  // counted by the database from the reviews of the product
  avgRating    Decimal @default(0) @db.Decimal(3, 2)
  reviewsCount Int     @default(0)

  // when the product was taken out of the catalog
  deletedAt DateTime?

  createdAt DateTime @default(now())
  // moved by the edits of an admin only; a view, a sale of stock and a new review do not move it
  updatedAt DateTime @default(now()) @updatedAt

  documents       ProductDocument[]
  reviews         Review[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  priceChangeLogs ProductPriceChangeLog[]
  images          ProductImage[]
  variants        ProductVariant[]
  batches         ProductBatch[]
  allocations     OrderBatchAllocation[]
  stockLogs       StockLog[]

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([euResponsibleId])
  @@index([createdAt, id])
  @@index([name, id])
  @@index([popularity, id])
  @@index([views, id])
  @@index([updatedAt, id])
  @@index([avgRating, id])
  @@index([reviewsCount, id])
  @@map("products")
}

// A picture in the gallery of a product, kept in Cloudinary. The gallery is loaded once for the
// product; every variant picks its own pictures from it (VariantImage), and lists, carts and
// orders show the pictures of the variant.
model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  // the id of the file in Cloudinary
  publicId String?
  alt      String?

  // the place in the gallery of the product
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  variantImages VariantImage[]

  @@index([productId, position])
  @@map("product_images")
}

// What a buyer chooses and buys of a product: a size, a color, a memory. A product has at least one
// variant; a book has just one and the buyer never notices it. The price, the sale, the stock, the
// article number, the weight and the size are the variant's, not the product's. The units are
// changed only by database functions (db/05): a delivery, a sale, a write-off, a cancel.
model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // the place among the variants of the product, set by an admin (a new variant is the last one);
  // the main variant of the card is the first one with free units (db/06 keeps the place unique)
  position Int

  // the article number: optional; one live variant of the catalog has a number, letter case
  // ignored, and a deleted variant lets it go (db/06)
  sku     String? @db.VarChar(64)
  // the barcode: 8, 12, 13 or 14 digits with a good check digit (the server checks it); one live
  // variant of the catalog has a code (db/06)
  barcode String? @db.VarChar(14)

  // the regular price, in the currency of the shop
  price         Decimal @db.Decimal(10, 2)
  // units on hand: the sum of what the batches have left. Only database functions change it
  stock         Int     @default(0)
  // units of stock held for confirmed orders that wait for payment
  reservedStock Int     @default(0)

  // the weight and the size of the variant packed for sending, in grams and millimetres. The
  // weight can be empty alone; the three sizes are set together or not at all (db/06)
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  // the sale: while saleEndsAt is ahead the variant sells at salePrice, which is below price. Both
  // are set or both are empty (db/06). A price put down to the sale price or below ends the sale
  // (db/05). After saleEndsAt the fields stay as they are and the sale is simply over
  salePrice      Decimal?  @db.Decimal(10, 2)
  saleEndsAt     DateTime?
  // the lowest price of the 30 days before the sale; it goes only with a sale (db/06)
  salePriorPrice Decimal?  @db.Decimal(10, 2)

  // when the variant was taken out of sale: a buyer sees and buys no such variant, an admin sees
  // and does everything. A product that is deleted takes its variants with it (db/05)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  // moved by the edits of an admin only
  updatedAt DateTime @default(now()) @updatedAt

  images          VariantImage[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  priceChangeLogs ProductPriceChangeLog[]
  batches         ProductBatch[]
  allocations     OrderBatchAllocation[]
  stockLogs       StockLog[]
  attributeValues VariantAttributeValue[]

  // the key a row of another table uses to name the variant together with its product, so the two
  // always belong together
  @@unique([id, productId])
  @@index([productId, deletedAt])
  @@index([price, id])
  @@index([stock, id])
  @@map("product_variants")
}

// A picture of the gallery that a variant shows, at a place of its own (the main picture of the
// variant is the first). A picture taken out of the gallery leaves every variant (db/06 keeps the
// place unique within a variant).
model VariantImage {
  id Int @id @default(autoincrement())

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  imageId Int
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  position Int

  createdAt DateTime @default(now())

  @@unique([variantId, imageId])
  @@index([imageId])
  @@map("variant_images")
}

// What a variant has of a characteristic of the directory: one row for a value, so a text, a number
// or a yes/no is one row, and a choice from a list is one row too; a characteristic that holds
// several values of its list (type options) has one row for each value chosen. Exactly one of the
// four value columns is set, the one the type of the characteristic asks for (db/05 keeps the value
// within its type, db/06 keeps one row for one value). A characteristic that has no row for a
// variant is a characteristic the variant does not have: there is no empty value.
model VariantAttributeValue {
  id Int @id @default(autoincrement())

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  // a value of the list of the characteristic (a choice, or one of several)
  optionId Int?
  option   AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  // a text, trimmed, up to 500 signs
  textValue   String?
  // a number, within the digits after the point and the bounds of the characteristic
  numberValue Decimal? @db.Decimal(18, 3)
  // yes or no
  boolValue   Boolean?

  @@index([attributeId, optionId])
  @@index([optionId])
  @@map("variant_attribute_values")
}

// -----------------------------------------------------------------------------
// Reviews and favorites
// -----------------------------------------------------------------------------

// A vote under the review of another buyer: for it or against it.
enum ReviewVoteAction {
  UP
  DOWN
}

// A review of a product by a buyer: a rating, a comment or both (db/06). A buyer has one review
// for each product.
model Review {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // from 1 to 5 (db/06); empty for a review that is only a comment
  rating Int?

  // counted by the database from review_votes (db/05)
  upVotes   Int @default(0)
  downVotes Int @default(0)

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  votes ReviewVote[]

  // the unique index also serves a search by userId alone
  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// A vote of a buyer for or against the review of another buyer, one vote for each buyer and
// review (a vote under the own review is refused). The database counts the votes into the review
// (db/05). Only the voter and the admins can read a vote row (db/03).
model ReviewVote {
  id Int @id @default(autoincrement())

  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action ReviewVoteAction

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

// A product in the favorites of a user or of a guest: exactly one of userId and guestId is set
// (db/06). When a guest signs in, the rows move to the account (migrate_guest_data_to_user).
model Favorite {
  id Int @id @default(autoincrement())

  userId  Int?
  // the guest id from the cookie
  guestId String? @db.Uuid
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // the variant the buyer likes; the product is kept beside it for the popularity of the product
  // (the two always belong together)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, variantId])
  @@unique([guestId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// Stock
// -----------------------------------------------------------------------------

// Where a batch of stock came from: a delivery of a supplier, a surplus an inventory found, or
// goods a buyer brought back.
enum StockSource {
  supplier
  surplus
  customer_return
}

// A batch of a product: units that came in at once, at one cost of a unit in the currency of the
// shop. The stock of the product is what its batches have left, and only database functions take
// a batch in or take units out of it (db/05). Who took the batch in, the supplier, the invoice and
// the note are in the admin journal (STOCK_DELIVERY).
model ProductBatch {
  id Int @id @default(autoincrement())

  // deleting a product row for good (the app only sets deletedAt) deletes its batches; a batch
  // that a paid order took units from cannot be deleted
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // a batch holds the units of one variant; the product is kept beside it (the two always belong
  // together)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  // the delivery the batch came with: one delivery takes in batches of several variants
  deliveryId String @db.Uuid

  source              StockSource
  // the number the supplier gave the batch, when there is one
  supplierBatchNumber String?

  unitCost  Decimal   @db.Decimal(10, 2)
  // the units that came in, and the units left after sales and write-offs
  quantity  Int
  remaining Int
  // the last day the goods are good for. A sale takes the batch that ends first, then the batches
  // without an end, oldest first; a batch that is over is not sold, it can only be written off
  expiresAt DateTime? @db.Date

  createdAt DateTime @default(now())

  allocations OrderBatchAllocation[]

  @@index([variantId, expiresAt, createdAt, id])
  @@index([productId])
  @@index([createdAt, id])
  @@index([deliveryId])
  @@map("product_batches")
}

// The journal of the stock: a line for every change of the quantity of a variant (product_variants
// stock), with the event that made it. Only added, nobody edits or deletes a line, and only admin and
// root read. The lines are written by the functions of the database that move the stock (db/05, by
// log_stock_change) in the same transaction: a delivery, a write-off, a sale at the payment of an
// order and the units back at the cancel of a paid order. A reserve and its release do not change
// the stock and have no line. For a variant whose stock only moved through those functions the
// sum of the quantityChange is its stock and the last stockAfter is its stock.
model StockLog {
  id Int @id @default(autoincrement())

  // who did it; empty for the work of the system (the sale at the payment of an order, which the
  // payment webhook does). The role is empty together with the account (db/06)
  actorId   Int?
  actor     User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole Role?

  // the variant, and its product beside it (the two always belong together). A variant that has a
  // line cannot be deleted for good
  productId Int
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)

  // what made the line: stock.delivery, stock.write_off, stock.sale, stock.return,
  // stock.return_write_off (the list is src/config/journalEvents.ts)
  event          String @db.VarChar(60)
  // the change of the stock, units in above 0 and out below 0, and the stock after it
  quantityChange Int
  stockAfter     Int
  // what the change was made of, a list of { field, old, new }: the batches with their costs, the
  // reason of a write-off, the supplier, the invoice and the note of a delivery
  meta           Json?

  // the operation that touched many variants carries one id in all its lines
  deliveryId   String?          @db.Uuid
  writeOffId   String?          @db.Uuid
  orderId      Int?
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // the row of a statement the units came back with or went out with (stock.return,
  // stock.return_write_off)
  returnItemId Int?
  returnItem   OrderReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  // the address and the browser of the request; empty for work done without a request
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@map("stock_log")
}

// -----------------------------------------------------------------------------
// Orders and payments
// -----------------------------------------------------------------------------

// pending: a cart. unconfirmed: a confirmed order that went back to a cart (its payment was
// cancelled or its reservation ended). waiting: confirmed, the stock is held until
// reservationExpiresAt, the payment is awaited. paid, shipped, delivered: the steps after the
// payment, one at a time. cancelled: a paid order cancelled by a statement of return, or a shipped
// one whose parcel came back with all the money (db/05, refresh_return_state).
enum OrderStatus {
  pending
  unconfirmed
  waiting
  paid
  shipped
  delivered
  cancelled
}

// Who took the money of an order. Only stripe has a module in the app, liqpay is not built yet.
enum PaymentProvider {
  stripe
  liqpay
}

// How an order gets to its buyer. manual: the shop sends it to an address itself, with a carrier it
// picks and works with outside the app. pickup: the buyer collects it at the shop. A carrier
// connected to the app would be another value.
enum DeliveryMethod {
  manual
  pickup
}

// A cart or an order of a buyer: one row goes through the whole life (see OrderStatus). The status,
// confirmed, reservationExpiresAt and paymentId match each other for a cart, a waiting and a paid
// order (db/06). Confirming,
// paying, cancelling and the end of the reservation are done by database functions; an admin moves
// a paid order to shipped and delivered (db/05).
model Order {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  status               OrderStatus @default(pending)
  // set while the order waits for the payment: the stock is held until then
  reservationExpiresAt DateTime?
  // true from the confirmation on
  confirmed            Boolean     @default(false)

  // what the buyer pays: the sum of the items, and once the order is confirmed the price of the
  // delivery on top of it (confirm_order, db/05)
  total Decimal @db.Decimal(10, 2)

  // who took the money and the id of the payment there (a Stripe PaymentIntent, a LiqPay order
  // id); pay_order sets both together
  paymentProvider PaymentProvider?
  paymentId       String?          @unique

  // when the payment was recorded (pay_order does it with the payment) and when the order became
  // cancelled (refresh_return_state, after a statement of return), in utc; only those functions
  // set them (db/03, db/06)
  paidAt               DateTime?
  cancelledAt          DateTime?
  // when the order became delivered: only the database sets it, with the step to delivered, and
  // takes it away with the step back (db/05). The days of the withdrawal count from it
  deliveredAt          DateTime?
  // what the contract in force said at the confirmation (confirm_order, db/05): the days to
  // withdraw and who pays the way back; empty while it is a cart, and for an order confirmed
  // while no contract was published
  withdrawalDays       Int?
  returnShippingPaidBy ReturnShippingPayer?
  // where the order stands as to its statements of withdrawal and return; only the database sets
  // it (refresh_return_state, db/05)
  returnStatus         ReturnStatus         @default(none)

  createdAt DateTime @default(now())
  // a trigger sets it on every change, also a change made by a database function (db/05)
  updatedAt DateTime @default(now()) @updatedAt

  // where and to whom the order goes, written with the confirmation
  delivery         OrderDelivery?
  // the sends of the order; the one with rolledBackAt empty is the current send
  shipments        OrderShipment[]
  items            OrderItem[]
  // the batches the paid order took units from
  allocations      OrderBatchAllocation[]
  // the lines of the stock log: the sale at the payment and the units back at the cancel
  stockLogs        StockLog[]
  // the versions of the terms and of the contract the order was confirmed with
  legalAcceptances LegalAcceptance[]
  // the statements of withdrawal and of return of the order
  returns          OrderReturn[]

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, confirmed, status, updatedAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([confirmed, reservationExpiresAt])
  @@index([paidAt, id])
  @@index([cancelledAt])
  @@map("orders")
}

// Where and to whom an order goes: one row for an order. It is written with the confirmation and
// stays when the order goes back to unconfirmed. A buyer is a person, never a company.
model OrderDelivery {
  orderId Int   @id
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method DeliveryMethod

  // the recipient: names without digits and a phone in the international form (db/06)
  recipientFirstName String @db.VarChar(100)
  recipientLastName  String @db.VarChar(100)
  recipientPhone     String @db.VarChar(16)

  // the address of the manual method, whole (db/06); all empty for a pickup. The country is a
  // two-letter code, the postal code is empty in a country that has none
  country    String? @db.VarChar(2)
  postalCode String? @db.VarChar(16)
  city       String? @db.VarChar(100)
  street     String? @db.VarChar(150)
  house      String? @db.VarChar(20)
  apartment  String? @db.VarChar(40)

  // a word for the courier
  note String? @db.VarChar(500)

  // what the buyer pays for the delivery, in the currency of the shop; part of Order.total from the
  // confirmation on (while the order is a cart again the price stays on the row and the total holds
  // the items only).
  // confirm_order fixes it by the rule the server passes in (db/05), nothing else writes it; a
  // pickup costs nothing (db/06)
  price Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([method])
  @@index([country, city])
  @@map("order_deliveries")
}

// One send of an order by the manual method: the carrier the shop used outside the app, the number
// and the link to follow it by, and what the shop pays the carrier. A pickup has none. An order
// can have several sends: when an admin takes the status back from shipped the row stays as
// history, marked with rolledBackAt, and the next shipping adds a new row.
model OrderShipment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // written by the admin; a number needs a carrier and a link needs a number, the link is https
  // (db/06)
  carrier        String? @db.VarChar(100)
  trackingNumber String? @db.VarChar(100)
  trackingUrl    String? @db.VarChar(500)

  // what the shop pays the carrier, empty until the admin writes it
  cost    Decimal? @db.Decimal(10, 2)
  // false when the shop owes the carrier nothing for this send: it was taken back and the admin did
  // not keep its cost, or the order was cancelled and the carrier was not paid. The reports count
  // the cost only while this is true
  expense Boolean  @default(true)

  // when the order was sent
  shippedAt    DateTime  @default(now())
  // when the status went back from shipped
  rolledBackAt DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([orderId, shippedAt])
  @@index([shippedAt])
  @@map("order_shipments")
}

// A line of an order: a variant of a product and a quantity. The database sets unitPrice and
// totalPrice from the price the variant sells at now, the caller cannot set them; the items of a
// confirmed order do not change (db/05).
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId])

  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  totalPrice  Decimal        @db.Decimal(10, 2)
  // the name of the variant (the name of the product and the values that tell the variants
  // apart): it follows the variant while the order is a cart, and the confirmation keeps the name
  // of that moment (db/05); empty on old items
  productName String?
  // the rule of withdrawal of the product: set by the database on every write of the item, the
  // confirmation keeps the rule of that moment (db/05); allowed on old items
  withdrawal  WithdrawalRule @default(allowed)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // the rows of statements that name the item
  returnItems OrderReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// The units that a paid order took from each batch, so the cost of the goods it sold is known. A
// cancel of the order puts the units back into the same batches and keeps the line for the
// reports.
model OrderBatchAllocation {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)

  batchId Int
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  quantity Int
  // how many of these units came back with a statement, into the same batch (never more than
  // were taken); the cost of what was returned is the cost of the batch
  returned Int @default(0)

  createdAt DateTime @default(now())

  @@unique([orderId, batchId])
  @@index([batchId])
  @@index([productId])
  @@index([variantId])
  @@map("order_batch_allocations")
}

// -----------------------------------------------------------------------------
// Withdrawal and returns
// -----------------------------------------------------------------------------

// Where a statement of withdrawal or return came from: the account of the buyer, the public form
// with the code of the link (the code vouches for the order), the form without a code (an admin
// checks it by hand), or an admin who made it.
enum ReturnSource {
  account
  form_code
  form_manual
  admin
}

// What the statement stands on: withdrawal is the right the law gives within the period (checked
// against the period and the rule of each product), other is a return outside it (a defect, a wrong
// item, damage, goodwill, a cancel by the shop), which only an admin makes.
enum ReturnBasis {
  withdrawal
  other
}

// Why an admin made a statement; empty on a statement of a buyer, whose own words are the
// description. shop_cancel is the cancel of a paid order by the shop, refused the refusal of a
// parcel at the door.
enum ReturnReason {
  defect
  wrong_item
  damaged
  goodwill
  shop_cancel
  refused
  other
}

// What became of the goods of a row of a statement. expected: not decided yet; to_stock: back on the
// shelf, in the batches they were sold from; written_off: came back and went out of the stock at
// once; not_accepted: arrived and the shop does not take them (the reason says why); lost: gone on
// the way, with the proof of the buyer; not_arrived: never came.
enum ReturnGoods {
  expected
  to_stock
  written_off
  not_accepted
  lost
  not_arrived
}

// What became of the money of a row: not_refunded yet, pending at the provider, refunded, or refused
// (the goods were not accepted or never came).
enum ReturnMoney {
  not_refunded
  pending
  refunded
  refused
}

// Why the shop did not accept the goods of a row.
enum ReturnNotAcceptedReason {
  unsealed
  mixed
  used
  damaged
  other
}

// Why a transfer of money back failed, in our words: card_unavailable (the card is closed, expired
// or lost: a retry is useless), shop_balance (the balance of the shop at the provider is short:
// top it up and retry), disputed (the buyer opened a dispute at the bank: the bank settles it, the
// money is not sent again), unknown (retry once, then outside the app).
enum ReturnRefundFailure {
  card_unavailable
  shop_balance
  disputed
  unknown
}

// Why root closed rows of a statement without a refund. Informational: a code does not decide
// whether a buyer may state the same units again.
enum ReturnCloseCode {
  buyer_changed_mind
  not_buyer
  goods_not_returned
  other
  // the buyer stated the same units from the account or with the code: a form without the code
  // gives them up
  stated_again
}

// How money was sent back outside the app, after a transfer failed; chargeback: the bank gave it
// back to the buyer, who disputed the payment and won.
enum ReturnOutsideMethod {
  bank_transfer
  cash
  other
  chargeback
}

// The state of an order as to its statements, one value for the whole order. none: no statement;
// open: a statement is open and no money went back yet; open_partial: one is open and part of the
// money went back; partial: all are closed and part went back; full: all are closed and all went
// back, the delivery too; declined: all are closed and nothing went back.
enum ReturnStatus {
  none
  open
  open_partial
  partial
  full
  declined
}

// Who pays the carrier for the parcel a buyer sends back when they withdraw from a purchase: the
// contract says it, an order keeps what the contract in force said at its confirmation.
enum ReturnShippingPayer {
  buyer
  shop
}

// A statement of a buyer that withdraws from the purchase of some goods of an order, or of an admin
// that returns them outside the withdrawal (a defect, a cancel by the shop). The statement keeps
// what the law asks of it: when it was made, by whom and from where (the address and the browser of
// the request), and the name and the email the answers go to, which outlive the account. One action
// is one statement, an extension is another one that points at the first. Never removed: only the
// database functions write it (create_return, receive_return_items, confirm_return_proof, db/05).
model OrderReturn {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // the number of the statement in its order (1, 2, 3...), set once by create_return (db/05): with
  // the basis and the order it is the code the buyer and the admins see, W42-2 or R42-2
  number  Int

  // the statement this one extends: another statement of the same order
  extendsId  Int?
  extends    OrderReturn?  @relation("ReturnExtension", fields: [extendsId], references: [id], onDelete: Restrict)
  extensions OrderReturn[] @relation("ReturnExtension")

  // the moment the law counts the period of the grant from: the database sets it, an admin may
  // name a moment of the past (a parcel refused at the door at a time the carrier gives)
  statedAt DateTime

  source      ReturnSource
  // the account that made it (the buyer, or the admin); empty for a form
  createdById Int?
  createdBy   User?         @relation("ReturnCreator", fields: [createdById], references: [id], onDelete: Restrict)
  basis       ReturnBasis
  reason      ReturnReason?
  // the words of the buyer, or of the admin; up to 2000 characters
  description String?       @db.VarChar(2000)

  // where the answers go: the name and the email of the statement, from the account or the form
  contactName  String @db.VarChar(200)
  contactEmail String @db.VarChar(320)

  // the address and the browser of the request
  ip        String?
  userAgent String?

  // the proof the buyer sent the goods back: given by the buyer, confirmed by an admin (who may
  // confirm it without a number, from a letter)
  proofProvidedAt     DateTime?
  // what the buyer wrote with it: the carrier and the number of the parcel, and a link to follow it
  proofCarrier        String?   @db.VarChar(100)
  proofTrackingNumber String?   @db.VarChar(100)
  proofTrackingUrl    String?   @db.VarChar(500)
  proofConfirmedAt    DateTime?
  proofConfirmedById  Int?
  proofConfirmedBy    User?     @relation("ReturnProofConfirmer", fields: [proofConfirmedById], references: [id], onDelete: Restrict)

  // a statement of the form without the code: when an admin accepted it as the buyer's and who
  // (db/05, accept_return); until then its goods and its money wait
  acceptedAt   DateTime?
  acceptedById Int?
  acceptedBy   User?     @relation("ReturnAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  // when every row has its result and who set the last one
  closedAt   DateTime?
  closedById Int?
  closedBy   User?     @relation("ReturnCloser", fields: [closedById], references: [id], onDelete: Restrict)

  // root closed rows without a refund: the code and the note of the last time (db/05)
  closeCode ReturnCloseCode?
  closeNote String?          @db.VarChar(500)

  // the shop pays the way back and the buyer paid the carrier: root gave it back outside the app,
  // once, with the day it went, the way and a note (db/05, record_return_reimbursement); the note
  // goes with the personal data of the statement
  shippingReimbursed       Decimal?             @db.Decimal(10, 2)
  shippingReimbursedAt     DateTime?
  shippingReimbursedMethod ReturnOutsideMethod?
  shippingReimbursedNote   String?              @db.VarChar(500)
  shippingReimbursedById   Int?
  shippingReimbursedBy     User?                @relation("ReturnShippingReimburser", fields: [shippingReimbursedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  // a trigger sets it on every change (db/05)
  updatedAt DateTime @default(now()) @updatedAt

  items     OrderReturnItem[]
  // the parcels the shop paid to carry the goods back (db/05, record_return_shipment)
  shipments ReturnShipment[]

  @@unique([orderId, number])
  @@index([extendsId])
  @@index([createdAt, id])
  @@index([closedAt])
  @@map("returns")
}

// A part of an item of an order named in a statement, with its own quantity, the state of its goods
// and of its money. A row starts as the whole of what the statement names and splits when only some
// of its units get a result, so one unit may come back late or be refused alone. The money of a
// row is the price of its units; the rules of the pairs (goods with money) are held by db/06.
model OrderReturnItem {
  id Int @id @default(autoincrement())

  returnId Int
  return   OrderReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity Int

  goods             ReturnGoods              @default(expected)
  // the reason the goods were not accepted; only with not_accepted
  notAcceptedReason ReturnNotAcceptedReason?
  money             ReturnMoney              @default(not_refunded)
  // what the units cost the buyer: the unit price of the item times the quantity, or less when
  // root lowered it (the note says why)
  amount            Decimal                  @db.Decimal(10, 2)
  amountNote        String?                  @db.VarChar(500)

  // the part of the delivery that goes back with this row: the last row that makes the order
  // whole carries all of it, the others 0
  deliveryShare     Decimal @default(0) @db.Decimal(10, 2)
  // the cost of the way back the buyer owes (the contract says the buyer pays, the shop paid the
  // carrier), taken off the transfer of this row: at most the parcels of the statement cost
  shippingDeduction Decimal @default(0) @db.Decimal(10, 2)

  // the transfer: the key of our side (one for all the rows one transfer covers, set before the
  // provider is asked and taken off when it fails), the id the provider gave it and the time the
  // money went back; the time is the day it happened, also for money sent outside the app
  refundKey  String?   @db.Uuid
  refundId   String?
  refundedAt DateTime?

  // the last transfer that failed: what the provider said in our code and in its words; it stays
  // until the transfer is tried again or the row is settled
  refundFailure     ReturnRefundFailure?
  refundFailureText String?              @db.VarChar(500)

  // money sent back outside the app by root: how, the note and who
  outsideMethod ReturnOutsideMethod?
  outsideNote   String?              @db.VarChar(500)
  outsideById   Int?
  outsideBy     User?                @relation("ReturnItemOutsideSetter", fields: [outsideById], references: [id], onDelete: Restrict)

  // why root closed the row without a refund
  refusedCode ReturnCloseCode?

  // who set the result of the goods and when
  goodsSetAt   DateTime?
  goodsSetById Int?
  goodsSetBy   User?     @relation("ReturnItemGoodsSetter", fields: [goodsSetById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // the lines of the stock log of the units that came back with the row
  stockLogs StockLog[]

  @@index([refundKey])
  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

// A parcel the shop paid to carry goods back from a buyer for a statement: a label the shop bought,
// or the carrier of the buyer that the shop paid back outside the app. It is an expense of the
// period it was sent in (shippedAt, written by the admin, never of the future), the cost may be
// written later. Only the database functions write it (record_return_shipment,
// set_return_shipment_cost, db/05); an admin reads it, a buyer does not.
model ReturnShipment {
  id Int @id @default(autoincrement())

  returnId Int
  return   OrderReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)

  // written by the admin; a number needs a carrier and a link needs a number, the link is https
  // (db/06)
  carrier        String? @db.VarChar(100)
  trackingNumber String? @db.VarChar(100)
  trackingUrl    String? @db.VarChar(500)

  // what the shop paid, empty until the admin writes it
  cost      Decimal? @db.Decimal(10, 2)
  // when the parcel was sent back, or the parcel refused: the moment of the refusal
  shippedAt DateTime

  recordedById Int
  recordedBy   User @relation("ReturnShipmentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([returnId])
  @@index([shippedAt])
  @@map("return_shipments")
}

// -----------------------------------------------------------------------------
// Journals and alerts
// -----------------------------------------------------------------------------

// How a change of a price was given: as a percent of the price or as an amount of money.
enum PriceChangeMode {
  percent
  fixed
}

// The kind of row a line of the admin journal is about.
enum AdminAuditEntityType {
  user
  product
  // a variant of a product: its price, its sale, its stock and its own edits
  variant
  category
  order
  review
  // a manufacturer or a person responsible in the EU of the directory of parties
  party
  // a file of the directory of documents (instructions, certificates)
  document
  // a group, a characteristic or a value of a characteristic of the directory of characteristics
  attribute
  other
}

// What an admin did. A line also has an event (see AdminAuditLog) that names the route or the
// condition when one action has several.
enum AdminAuditAction {
  USER_ROLE_CHANGE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  PRODUCT_PRICE_BULK_UPDATE
  // a sale set, changed or taken off by an admin, or ended by a price put down to it (db/05)
  PRODUCT_SALE
  // goods taken in and units written off: one line for the whole delivery or write-off, written
  // by the server; the line of each variant is in the stock log (db/05)
  STOCK_DELIVERY
  STOCK_WRITE_OFF
  // a step of the shipping, a step back, or a cancel
  ORDER_STATUS_CHANGE
  // the carrier, number, link or cost of a send corrected, and the recipient or address of a paid
  // order corrected before it is sent
  ORDER_SHIPMENT_CHANGE
  ORDER_DELIVERY_CHANGE
  CATEGORY_UPDATE
  REVIEW_DELETE
  // everything else: an avatar removed, an account deleted, a late payment refunded, a category
  // created or deleted
  OTHER
}

// The journal of price changes of products. Only added: nobody edits or deletes a line, and the app
// writes a line only through log_product_price_change, in the name of the admin of the request
// (db/05).
model ProductPriceChangeLog {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // the variant whose price changed; the product is kept beside it (the two always belong together)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)

  actorId Int
  actor   User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  // the price before and after the change. A sale goes from the price down to the sale price,
  // taking it off goes from the sale price back to the price
  oldPrice Decimal @db.Decimal(10, 2)
  newPrice Decimal @db.Decimal(10, 2)

  // how the change was given, and its size in that mode (the percent or the amount of money),
  // negative for a change down
  mode  PriceChangeMode
  value Decimal         @db.Decimal(10, 2)

  // the end of the sale: a line with it is the start of a sale, from the price down to the sale
  // price (db/06); empty for any other line
  endsAt DateTime?

  // what made the line, finer than mode: price.set, price.set_batch, price.bulk,
  // price.sale_start, price.sale_end (the list is src/config/journalEvents.ts)
  event String @db.VarChar(60)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([actorId, createdAt])
  @@index([event, createdAt])
  @@map("product_price_change_logs")
}

// The journal of what admins and root did. Only added: nobody edits or deletes a line. A line is
// written by log_admin_action (db/05).
model AdminAuditLog {
  id Int @id @default(autoincrement())

  actorId Int
  actor   User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  // the role of the actor at that time
  actorRole Role

  // the kind and the id of the row the line is about
  entityType AdminAuditEntityType
  entityId   Int?

  action AdminAuditAction
  // what made the line, finer than the action: the route or the condition (product.update_batch,
  // order.ship_bulk, ...); the list is src/config/journalEvents.ts
  event  String           @db.VarChar(60)
  // the changes, a list of { field, old, new }
  meta   Json?

  // the address and the browser of the request; empty for work done without a request
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  // the reports read the lines of one action in a period, for example the write-offs of a month
  @@index([action, createdAt])
  @@index([event, createdAt])
  @@map("admin_audit_log")
}

// The setting of one kind of alerts for one admin or root, each their own: whether they follow the
// kind and its threshold. A kind without a row is followed with the default threshold of the
// server.
model AdminAlertSetting {
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the kind of the alert (the list is src/routes/api/admin/services/helpers/alertKinds.helper.ts)
  kind       String  @db.VarChar(64)
  subscribed Boolean @default(true)
  // the limit the kind counts against, its unit depends on the kind; empty means the default of
  // the server, a number is at least 1 (db/06)
  threshold  Int?

  createdAt DateTime @default(now())

  @@id([userId, kind])
  @@map("admin_alert_settings")
}

// -----------------------------------------------------------------------------
// Chat
// -----------------------------------------------------------------------------

enum ChatStatus {
  open
  closed
}

// bot: the bot answers. admin: the person asked for an admin and the admins answer.
enum ChatType {
  bot
  admin
}

// Who wrote a message: a user or an admin (an account), a guest (no account) or the bot.
enum ChatMessageSenderType {
  user
  admin
  bot
  guest
}

// A chat of a user or of a guest: exactly one of userId and guestId is set, and a person has at
// most one open chat (db/06). It starts with the bot; when the bot hands it to the admins its type
// becomes admin. An open admin chat always has adminRequestedAt or adminUnreadSince, a bot chat
// and a closed chat have neither (db/06).
model ChatThread {
  id String @id @db.Uuid

  userId  Int?
  // the guest id from the cookie
  guestId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   ChatType
  status ChatStatus @default(open)

  lastMessageAt      DateTime  @default(now())
  // the messages of the person in an admin chat that no admin has read yet
  unreadCount        Int       @default(0)
  // the time of the latest message of the person to the admins (an admin who opens a chat before
  // any message sets it to now); a chat that has it is in the queues of the admins, closing the
  // chat clears it
  adminUnreadSince   DateTime?
  // when the bot handed the chat to the admins; the chat waits in the queue until an admin opens,
  // reads, answers or closes it
  adminRequestedAt   DateTime?
  // the first 120 characters of the latest message
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([userId, status, type, lastMessageAt])
  @@index([guestId, status, type, lastMessageAt])
  @@index([status, adminUnreadSince])
  @@map("chat_threads")
}

// A message in a chat.
model ChatMessage {
  id Int @id @default(autoincrement())

  threadId String     @db.Uuid
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // the account of a user or an admin; empty for the bot and a guest (db/06)
  senderId Int?
  sender   User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  senderType ChatMessageSenderType

  content String

  // read by the recipient
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// -----------------------------------------------------------------------------
// Terms, contract and privacy policy
// -----------------------------------------------------------------------------

// The legal texts of the shop. A buyer accepts the terms and the contract; the privacy policy only
// informs, nobody accepts it.
enum LegalDocumentKind {
  terms
  contract
  privacy
}

// A version of the terms or of the contract of the shop. Root publishes it and nobody changes or
// deletes it. The database numbers the versions of each kind and stores the sha256 of the text
// (db/05); the newest version of a kind is the one in force.
model LegalDocument {
  id            Int               @id @default(autoincrement())
  kind          LegalDocumentKind
  // the number within the kind, from 1; set by the database
  version       Int
  title         String            @db.VarChar(200)
  content       String
  // the sha256 of the text in hex; set by the database
  sha256        String            @db.VarChar(64)
  publishedById Int
  publishedBy   User              @relation("LegalDocumentPublisher", fields: [publishedById], references: [id])

  // the contract only, and all three of it (db/06): the days a buyer has to withdraw after the
  // delivery (14 at least), where they send the goods back, who pays the carrier for it
  withdrawalDays       Int?
  returnAddress        String?              @db.VarChar(500)
  returnShippingPaidBy ReturnShippingPayer?

  // the privacy policy only, and all six of it (db/06): how long each kind of personal data is
  // kept, in days, counted the way the cleanups of db/05 say
  retentionLoginAddressesDays  Int?
  retentionGuestDataDays       Int?
  retentionDeletedChatsDays    Int?
  retentionReturnAddressesDays Int?
  retentionReturnPersonalDays  Int?
  retentionRecipientDays       Int?

  createdAt DateTime @default(now())

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@map("legal_documents")
}

// A consent of a buyer to a version in force. orderId is empty for a consent given at the
// registration or later, and set for the versions an order was confirmed with. Only added: nobody
// edits or deletes a line, besides the lines of an unconfirmed order, which go with it (cascade).
// The database takes ip and userAgent from the request and refuses a
// version that is not in force (db/05).
model LegalAcceptance {
  id         Int           @id @default(autoincrement())
  userId     Int
  user       User          @relation(fields: [userId], references: [id])
  documentId Int
  document   LegalDocument @relation(fields: [documentId], references: [id])
  orderId    Int?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // the address and the browser of the request
  ip         String?
  userAgent  String?
  // where the person agreed: consent.register, consent.login, consent.oauth_signup,
  // consent.oauth_login, consent.accept, consent.order (the list is src/config/journalEvents.ts)
  event      String        @db.VarChar(60)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([event, createdAt])
  @@map("legal_acceptances")
}

// A version of the data of the shop (delivery, brand, reservation, moderation, withdrawal,
// languages, the seller): added when root changes a setting, or when the server fills in the
// default of an empty field at startup (setById null, "the system"; db/shop-settings.md). The
// current version is the one with the highest number; a row is never changed or removed (db/03,
// db/05). A field left empty here falls back to the default the server code has, or, for a field
// without one, stays empty until root sets it.
model ShopSetting {
  id Int @id @default(autoincrement())

  // set by trg_shop_settings_before_insert (db/05): the row before this one, plus one
  version Int

  // root who wrote this version; null for a row the server wrote for an empty field
  setById Int?
  setBy   User? @relation(fields: [setById], references: [id], onDelete: Restrict)

  // the version root saw before writing this one, for the conflict check of the trigger; null
  // skips the check (the rows the server writes for empty fields)
  basedOnVersion Int?

  // delivery (public): the ways the shop ships an order, the countries it ships to (ISO 3166
  // alpha-2), the price and the free-from of the manual method, where and when a buyer collects a
  // pickup order
  deliveryMethods   String[]
  deliveryFlatPrice Decimal? @db.Decimal(10, 2)
  deliveryFreeFrom  Decimal? @db.Decimal(10, 2)
  deliveryCountries String[]
  pickupAddress     String?  @db.VarChar(300)
  pickupHours       String?  @db.VarChar(300)

  // brand and mail: the name and the logo are public, the sender name and the reply-to are not
  shopName      String? @db.VarChar(100)
  emailFromName String? @db.VarChar(100)
  emailReplyTo  String? @db.VarChar(254)
  logoUrl       String?
  logoPublicId  String?

  // reservation, in minutes (not public)
  reservationMinutes Int?
  stripePageMinutes  Int?

  // moderation (not public)
  reviewCheckEnabled  Boolean?
  avatarRemovalsLimit Int?
  reviewRemovalsLimit Int?

  // days of grace added to the legal minimum of a withdrawal (not public)
  withdrawalGraceDays Int?

  // languages (public): the mother tongue of the shop (falls back to it when a buyer's own has no
  // dictionary), the ones turned on (each needs a dictionary; the shop's own must be among them)
  shopLocale     String?  @db.VarChar(2)
  enabledLocales String[]

  // the seller the shop must name on its pages, its mails, its receipts and its invoices (public)
  sellerLegalName String? @db.VarChar(200)
  sellerAddress   String? @db.VarChar(500)
  sellerTaxId     String? @db.VarChar(50)
  sellerEmail     String? @db.VarChar(254)
  sellerPhone     String? @db.VarChar(30)

  createdAt DateTime @default(now())

  @@unique([version])
  @@map("shop_settings")
}
