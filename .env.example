// Default
// development, test or production (development unless given); any other value stops the start
NODE_ENV=
PORT=
HOST=

// frontend address: mail links, oauth redirects and the only site CORS and the chat websocket let in
WEB_ORIGIN=https://shop.example.com
// address the API is reached on from outside (an https address in production, no path): the one-click unsubscribe of a newsletter mail (the header List-Unsubscribe) names it. Required in development and production, the start stops without it (only the tests may go without)
API_ORIGIN=https://api.shop.example.com
// domain the site lives on, without https:// (required in production): a deleted account gets an address on it
SITE_DOMAIN=shop.example.com
// the pages of the frontend on WEB_ORIGIN the server links to and sends the browser back to, a path from /;
// the page of an order or of a product names it by {id}
// the page a login with google, github or linkedin comes back to (/auth/callback unless given)
WEB_PAGE_OAUTH_CALLBACK=
// the page the mail after a change of the password links to (/web/login unless given)
WEB_PAGE_LOGIN=
// the page the link of an email verification opens, with #token= (the page posts it to POST /api/auth/verify; /web/login unless given, no # in the value)
WEB_PAGE_VERIFY_EMAIL=
// the page the link of a password reset opens, with #token= (the page posts it with the new password to POST /api/auth/password/reset; /web/auth/reset unless given, no # in the value)
WEB_PAGE_PASSWORD_RESET=
// the page the stripe payment page sends the buyer back to, with ?session_id= (/checkout/success unless given)
WEB_PAGE_CHECKOUT_SUCCESS=
// the page the stripe payment page sends the buyer back to on cancel, with ?orderId= (/checkout/cancel unless given)
WEB_PAGE_CHECKOUT_CANCEL=
// the page the mails of an order link to (/orders/{id} unless given)
WEB_PAGE_ORDER=
// the page of the form of withdrawal the mails link to, the code of the order after the # (/orders/{id}/withdrawal unless given)
WEB_PAGE_WITHDRAWAL=
// the page the mail of a delivered order asks to rate each product on (/products/{id}#reviews unless given)
WEB_PAGE_PRODUCT_REVIEWS=
// the page of a product the cards of a newsletter mail link to, with {id} once (/products/{id} unless given)
WEB_PAGE_PRODUCT=
// the page of a category the cards of a newsletter mail link to, with {id} once (/categories/{id} unless given)
WEB_PAGE_CATEGORY=
// the page the button "Confirm the subscription" of the newsletter mail opens, with #token= (/newsletter/confirm unless given); no # in the value
WEB_PAGE_NEWSLETTER_CONFIRM=
// the page the button "This is not me" of the same mail opens, with #token= (/newsletter/decline unless given); no # in the value
WEB_PAGE_NEWSLETTER_DECLINE=
// the page "Manage the subscription" of the newsletter mails opens, with #token= (/newsletter/manage unless given); no # in the value; the unsubscribe button of a mail leads there too, with #unsubscribe=
WEB_PAGE_NEWSLETTER_MANAGE=

// db
DATABASE_URL=
MIGRATION_DATABASE_URL=
DEV_SHADOW_DATABASE_URL=

// Redis 
REDIS_URL=
REDIS_ORDER_TIMEOUT_WORKER_MS=

// JWT
JWT_ACCESS_SECRET=
// lifetimes in seconds; a value that is not a positive whole number stops the start
JWT_ACCESS_TTL_SHORT=
JWT_ACCESS_TTL_LONG=

JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SHORT=
JWT_REFRESH_TTL_LONG=

GUEST_ID_TTL=

RESET_TTL_MS=
// the life of the link of an email verification in ms, a day unless given
VERIFY_TTL_MS=

BCRYPT_ROUNDS=

// the requests a minute one address may make, 100 unless given
RATE_LIMIT_MAX=
// multiplies every limit of a route (1 unless given)
REQUEST_LIMITS_SCALE=
// the proxies in front of the server whose x-forwarded-for is trusted (1 unless given: railway puts one)
TRUST_PROXY_HOPS=
// true logs the addresses of each request, to check how many proxies a new host puts in front
LOG_REQUEST_ADDRESSES=

// the most requests of each limit of a route, the windows stay in the code
// the logins from one address in 10 minutes (30 unless given)
LIMIT_LOGIN_PER_ADDRESS=
// the logins of one email in 10 minutes (10 unless given)
LIMIT_LOGIN_PER_EMAIL=
// the registrations from one address in an hour (10 unless given)
LIMIT_REGISTER_PER_ADDRESS=
// the registrations of one email in 3 minutes, only the ones that succeed count (1 unless given)
LIMIT_REGISTER_PER_EMAIL=
// the mails of a reset or a verification from one address in 15 minutes (10 unless given)
LIMIT_MAIL_PER_ADDRESS=
// the mails of a reset or a verification to one address in 3 minutes (1 unless given)
LIMIT_MAIL_PER_EMAIL=
// the payment pages of a user in a minute (10 unless given)
LIMIT_CHECKOUT_PER_USER=
// the changes of the password of a user in 15 minutes (10 unless given)
LIMIT_PASSWORD_CHANGE_PER_USER=
// the exports of the data of a user in an hour (1 unless given)
LIMIT_EXPORT_PER_USER=
// the reviews of a user in an hour (30 unless given)
LIMIT_REVIEW_PER_USER=
// the translations of the texts of a campaign a manager of the newsletters asks for in an hour (20 unless given)
LIMIT_NEWSLETTER_TRANSLATE_PER_USER=
// the test mails of a campaign a manager of the newsletters sends in an hour, in all campaigns together (30 unless given)
LIMIT_NEWSLETTER_TEST_PER_USER=
// the requests from one address to the pages behind the links of the newsletter mails (confirm, "this is not me", the management of a subscription) in 10 minutes, one fixed window that starts with the first request (60 unless given)
LIMIT_NEWSLETTER_LINK_PER_ADDRESS=
// the requests from one address to the unsubscribe button of the newsletter mails (the one-click POST of a mail client and the GET of the link) in 10 minutes, one fixed window of its own count, which the general limit above does not count (1000 unless given)
LIMIT_NEWSLETTER_UNSUBSCRIBE_PER_ADDRESS=
// the calls of an admin by the button of a chat the bot could not answer, from a user in an hour (10 unless given)
LIMIT_CHAT_CALL_ADMIN_PER_USER=
// the statements of withdrawal a user makes from their account in an hour (10 unless given)
LIMIT_WITHDRAWAL_PER_USER=
// the requests of the public form of withdrawal from one address in an hour (20 unless given)
LIMIT_WITHDRAWAL_FORM_PER_ADDRESS=
// the requests of the public form of withdrawal for one order without its code, from every address, in an hour (5 unless given)
LIMIT_WITHDRAWAL_FORM_PER_ORDER=
// the requests of the public form of withdrawal with the same phone (or name) of a recipient without the code, from every address, in an hour (5 unless given)
LIMIT_WITHDRAWAL_FORM_PER_DATA=
// the wrong passwords of an account before its login pauses for a minute, doubling after (5 unless given)
LOGIN_FAILURES_BEFORE_PAUSE=

// the biggest file of a form in bytes (5000000 unless given), the most pictures in the gallery of a product
// (50 unless given), the most variants of a product (200 unless given) and the most pictures of the gallery
// one variant shows (10 unless given)
UPLOAD_MAX_BYTES=
PRODUCT_IMAGES_MAX=
PRODUCT_VARIANTS_MAX=
VARIANT_IMAGES_MAX=
DOCUMENT_MAX_BYTES=
PRODUCT_DOCUMENTS_MAX=
ATTRIBUTE_OPTIONS_MAX=
// the values of a set (several values of a list) one variant has for one characteristic (50 unless given, 1000 at most)
ATTRIBUTE_MULTI_VALUES_MAX=

// the time zone of the days and months of the reports, Europe/Madrid unless given
SHOP_TIME_ZONE=

// Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

// OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=
OPENAI_MAX_OUTPUT_TOKENS=
// the answers of the chat bot a guest (30 unless given) and a user (100 unless given) get in 24 hours; a user with an unconfirmed email counts as a guest
CHAT_BOT_GUEST_DAILY_TURNS=
CHAT_BOT_USER_DAILY_TURNS=
// the turns of guests and unconfirmed users from one address in 24 hours (60 unless given)
CHAT_BOT_IP_DAILY_TURNS=
// the turns of the whole shop that call the model in 24 hours, the ceiling of the bill (3000 unless given)
CHAT_BOT_SHOP_DAILY_TURNS=

SENDGRID_API_KEY=
EMAIL_FROM=

// the newsletters and the captcha: all required, the start stops without them in development and production (the tests have values of their own)
// the key of the SendGrid account of the newsletters (Mail Send and Suppressions); not SENDGRID_API_KEY: the mails of orders and the newsletters are two streams with lists of their own
SENDGRID_NEWSLETTER_API_KEY=
// the Verification Key of the Event Webhook of that account, the base64 of a DER public key of the curve P-256, as SendGrid shows it
SENDGRID_NEWSLETTER_WEBHOOK_KEY=
// the sender of the newsletters, a bare address of the authenticated domain (no Reply-To)
NEWSLETTER_EMAIL_FROM=
// signs the blocklist of the subscription form: base64 or base64url of 32 bytes or more. Another on dev than on prod, never changed after the launch (the blocked addresses would stop being found)
NEWSLETTER_BLOCK_SECRET=
// signs the links "Manage the subscription" and the unsubscribe button (List-Unsubscribe) of the newsletters: base64 or base64url of 32 bytes or more, not the value of NEWSLETTER_BLOCK_SECRET. Another on dev than on prod, never changed after the launch (the links in the mails already sent stop working)
NEWSLETTER_LINK_SECRET=
// the newsletters sent in one day, a whole number from 1: set under the plan of SendGrid, whose limit the mails of orders share
NEWSLETTER_DAILY_LIMIT=
// the minutes a newsletter mail the provider did not take (busy, no answer, refused in a run that stopped the pass) waits before it is tried again, a whole number from 1 to 1440 (10 unless given)
NEWSLETTER_RETRY_MINUTES=
// how many times a newsletter mail is tried before it is given up, a whole number from 1 to 20 (5 unless given)
NEWSLETTER_MAX_ATTEMPTS=
// the secret key of the Cloudflare Turnstile widget that checks the captcha of the forms (1x0000000000000000000000000000000AA is the test secret of Cloudflare, it passes every check)
TURNSTILE_SECRET_KEY=

//OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_STATE_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_STATE_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_STATE_SECRET=

// Stripe
STRIPE_SECRET_KEY=
// required: the start stops without it in development and production, only the tests go without (every stripe event would be refused)
STRIPE_WEBHOOK_SECRET=
// signs the number of an order into the code of the links of withdrawal in the mails (32 characters at least); required: the start stops without it in development and production. Another value on dev than on prod: the codes of prod do not work there
WITHDRAWAL_CODE_SECRET=

// a three letter code of a currency with cents (eur unless given); jpy, kwd and the like stop the start
STRIPE_CURRENCY=

// tests only, the app never reads it: the secret key of a Stripe test sandbox (sk_test_)
// the payment tests pay and refund with; never a live key, the tests stop on any other
STRIPE_TEST_SECRET_KEY=